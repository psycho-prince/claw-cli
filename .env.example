# Example environment variables for Claw-CLI and ClawCloud

# === Core Claw-CLI Settings ===
# Set to 'true' to enable ClawCloud server features. Default is 'false' (local CLI mode).
CLAW_CLOUD_ENABLED=false

# === ClawCloud Server Settings (only applies when CLAW_CLOUD_ENABLED=true) ===
# Port for the ClawCloud server to listen on.
PORT=3000

# Secret for JWT token generation and verification. CHANGE THIS IN PRODUCTION!
JWT_SECRET="your_secure_jwt_secret_here_change_me"

# Stripe API Key for webhook verification and billing (e.g., sk_live_YOUR_KEY)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Stripe Webhook Secret (whsec_YOUR_SECRET)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Database path for SQLite. Relative to the project root.
DATABASE_URL="./data/clawcloud.db"

# Admin API Key for internal ClawCloud management. CHANGE THIS IN PRODUCTION!
ADMIN_API_KEY="your_secure_admin_api_key_change_me"

# === LLM Integration Settings ===
# API Key for your LLM provider (e.g., Gemini API key)
GEMINI_API_KEY="your_gemini_api_key"

# Add other sensitive configurations here.
